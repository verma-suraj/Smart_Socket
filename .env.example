# MQTT Broker Configuration
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=1
MQTT_RECONNECT_BASE_DELAY=1000
MQTT_RECONNECT_MAX_DELAY=60000
MQTT_COMMAND_ACK_TIMEOUT=5000
MQTT_COMMAND_MAX_RETRIES=3

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Adaptive Load Management
ALM_DEFAULT_THRESHOLD=10000
ALM_EVALUATION_DEBOUNCE_MS=1000

# Temperature Safety Thresholds (°C)
TEMP_OVERRIDE_THRESHOLD=40
TEMP_REACTIVATION_THRESHOLD=38

# Session Defaults
SESSION_DEFAULT_SOC=0.20
SESSION_PER_UNIT_RATE=8.0

# Node Health
NODE_STALE_THRESHOLD_MS=30000

# Server
PORT=8080
HOST=0.0.0.0
