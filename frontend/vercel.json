{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://smart-socket-backend-REPLACE_ME.run.app/api/:path*"
    },
    {
      "source": "/ws",
      "destination": "https://smart-socket-backend-REPLACE_ME.run.app/ws"
    },
    {
      "source": "/((?!api|ws).*)",
      "destination": "/index.html"
    }
  ]
}
