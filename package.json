{
  "name": "smart-socket-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "ESP32-S3 Smart Socket EV Charging Platform Backend",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "dev": "node --loader ts-node/esm -r dotenv/config src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:property": "vitest --run tests/property",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration"
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "firebase-admin": "13.0.2",
    "mqtt": "5.10.4",
    "smart-socket-backend": "file:",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "@types/ws": "8.5.13",
    "fast-check": "3.23.2",
    "ts-node": "10.9.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
